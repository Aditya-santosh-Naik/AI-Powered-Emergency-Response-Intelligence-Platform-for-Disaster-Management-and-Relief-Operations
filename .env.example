# Database — used by docker-compose and backend
POSTGRES_USER=erp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=emergency_response
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed from the above; override if your setup differs
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Ingestion schedule — interval in minutes between polling runs
INGESTION_INTERVAL_MINUTES=30

# NASA FIRMS — free key from https://firms.modaps.eosdis.nasa.gov/api/area/
# Leave blank to skip FIRMS ingestion gracefully
FIRMS_MAP_KEY=

# Frontend — Vite injects this at build time
VITE_API_BASE_URL=http://localhost:8000/api/v1
